# Browser-safe Supabase connection values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value in HTML, browser bundles or logs.
SUPABASE_SECRET_KEY=

# Must also be included in the Supabase Auth redirect allow-list.
SUPABASE_INVITE_REDIRECT_URL=http://127.0.0.1:5173/supabase-pilot.html

# Gradual cutover. When true, all case routes in the main prototype open the isolated Supabase workspace.
SUPABASE_CASE_WORKSPACE_ENABLED=false
